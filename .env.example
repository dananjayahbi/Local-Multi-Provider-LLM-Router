# Local Multi-Provider LLM Router — Environment Configuration

# Database file path (relative to project root)
DATABASE_URL="file:./dev.db"

# Secret key used to encrypt provider API keys at rest
# Generate a strong random value: openssl rand -hex 32
ENCRYPTION_SECRET="change-me-to-a-random-64-char-hex-string"

# Server port
PORT=3000

# Server host (bind to localhost only for security)
HOST="localhost"
