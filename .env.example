
# ─── Pool hold / exhausted-pool policy ─────────────────
# How long (seconds) the gateway holds a request when every key in a pool is
# penalized, waiting for one to recover before retrying. 0 = disabled. Default
# 600 (10 min) — covers the full exhausted-pool hold policy.
RECOVERY_WAIT_MAX_SECONDS=600
# Once every key in a pool is exhausted, the pre-defined "pool exhausted"
# completion is only emitted when the SHORTEST remaining penalty exceeds this
# value (seconds). Shorter penalties keep the request queued until a key
# recovers. Default 600 (10 min).
EXHAUSTED_MIN_PENALTY_SECONDS=600

# ─── Universal client fidelity (docs/10-...) ────────────
# Default client profile when a request carries no explicit override and is not
# recognized as GitHub Copilot: `copilot` (default, zero behavior change) or
# `universal` (correct fidelity for generic OpenAI-compatible agents such as
# Zoo Code / Cline — bridges reasoning into `content`, never strips tools, gates
# the Copilot `askQuestion` injection off, emits a `[ROUTER-OUTAGE]` marker).
# A client may also pin its own profile per request via the header
# `x-router-client-profile: copilot|universal`.
ROUTER_DEFAULT_CLIENT_PROFILE=copilot

# ─── Time-to-first-token (docs/10-...) ──────────────────
# Maximum time (ms) a request may WAIT for a key's rate-limit window to free up
# before the router fails over to another key instead of holding the request.
# Default 1500. Set higher only if you run a single key and prefer waiting.
ROUTER_MAX_PRE_DISPATCH_WAIT_MS=1500
