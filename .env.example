# Local Multi-Provider LLM Router — Environment Configuration (template)
# Copy to `.env` and fill in your values.

# Database file path (relative to project root)
DATABASE_URL="file:./dev.db"

# Secret key used to encrypt provider API keys at rest
# Generate a strong random value: openssl rand -hex 32
ENCRYPTION_SECRET="change-me"

# Server port
PORT=4006

# How long (seconds) the gateway holds a request when every key in a pool is
# penalized, waiting for one to recover before retrying. 0 = disabled.
RECOVERY_WAIT_MAX_SECONDS=240

# Once every key in a pool is exhausted, the pre-defined "pool exhausted"
# completion is only emitted when the SHORTEST remaining penalty exceeds this
# value (seconds). Shorter penalties keep the request queued until a key
# recovers. Default 1800 (30 min).
EXHAUSTED_MIN_PENALTY_SECONDS=1800

# How far back (seconds) the router looks at durable SUCCESS request logs on
# boot to re-hydrate its in-memory RPM/TPM/RPD/TPD sliding windows. This keeps
# the router remembering recent usage across a PC/container restart so it never
# stops pre-throttling and hits a spurious provider 429. 0 = disable hydration.
# Default 86400 (24h, covers the daily windows).
RATE_WINDOW_HYDRATION_LOOKBACK_SECONDS=86400

# How long (ms) a multi-session key lock survives without any request from its
# session touching it before it is swept. 0 = never expire. Default 3600000
# (60 min) — a session that closed its VSCode window stops pinning its key.
SESSION_LOCK_TTL_MS=3600000

# Set to 1 to log each resolved session id + every session→key lock decision at
# the gateway. Helpful to confirm sessions are pinned (KEPT) and not rotating.
SESSION_ID_DEBUG=0

# Server host (bind to localhost only for security)
HOST="localhost"

# ─── Hermes Agent LLM Extraction ───────────────────────
# Optional smart LLM-based extraction for discovery. Leave empty for the
# heuristic fallback.
HERMES_LLM_BASE_URL=https://api.openai.com/v1
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=gpt-4o-mini
