# ─── LLM Router Environment ────────────────────────────
# Copy this file to `.env` and fill in your values.
# The .env file is used by docker-compose to inject secrets.

# REQUIRED: Strong random secret for encrypting provider API keys.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ENCRYPTION_SECRET=change-me-to-a-long-random-string-64-characters-minimum

# Database location (SQLite file). Default is fine.
DATABASE_URL="file:./dev.db"

# Port the router listens on (default 4006)
PORT=4006

# ─── Hermes Agent (optional) ───────────────────────────
# Set HERMES_LLM_API_KEY to enable smart LLM-based extraction
# during provider discovery. The agent uses this key to call an
# OpenAI-compatible chat completions endpoint to parse web content
# into structured provider records. If left empty, the agent uses
# a heuristic parser instead.
HERMES_LLM_BASE_URL=https://api.openai.com/v1
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=gpt-4o-mini
